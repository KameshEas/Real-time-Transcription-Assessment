# Copy to .env and fill in. Format is KEY=value (no colons, no quotes needed).

# --- AI vendors (API-only; nothing is hosted locally) ---
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_STREAM_TYPE=fast
SARVAM_TTS_MODEL=bulbul:v4-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- Runtime ---
APP_ENV=local
APP_ROLES=api,gateway,worker
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Persistence ---
# postgres (default) or memory (no database; data is lost on restart)
PERSISTENCE_BACKEND=postgres
# Any Postgres URL, pasted as the provider gives it. Supabase: use the *Session pooler* string
# (postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres).
# docker compose sets its own value for the backend container.
DATABASE_URL=
# Integration tests: when set, API/gateway tests also run against this database, in a throwaway schema.
TEST_DATABASE_URL=

# --- Supabase ---
# Project URL (API gateway). Postgres itself is reached through DATABASE_URL above, not this URL.
SUPABASE_URL=https://supabase.aspired2d.cloud
# Private Storage bucket for generated transcript files (exports). Audio is never stored (ADR-0005).
SUPABASE_STORAGE_BUCKET=transcript-exports
# Server-side key for Storage uploads; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Scale adapters (Stage 1+) ---
QUEUE_BACKEND=memory
RATE_LIMIT_BACKEND=memory
REDIS_URL=

# --- Policy / flags ---
ENABLE_SARVAM=true
ENABLE_TTS=true
USE_FAKE_RECOGNIZER=false
MAX_SESSION_SECONDS=600
REVIEW_PASSCODE=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
