# Copy to .env and fill in. Format is KEY=value (no colons, no quotes needed).

# --- AI vendors (API-only; nothing is hosted locally) ---
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_STREAM_TYPE=fast
SARVAM_TTS_MODEL=bulbul:v4-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- Runtime ---
APP_ENV=local
APP_ROLES=api,gateway,worker
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Persistence (docker compose overrides this for the backend container) ---
DATABASE_URL=postgresql+asyncpg://hinglish:hinglish@localhost:5432/hinglish

# --- Scale adapters (Stage 1+) ---
QUEUE_BACKEND=memory
RATE_LIMIT_BACKEND=memory
REDIS_URL=

# --- Policy / flags ---
ENABLE_SARVAM=true
ENABLE_TTS=true
USE_FAKE_RECOGNIZER=false
MAX_SESSION_SECONDS=600
REVIEW_PASSCODE=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
